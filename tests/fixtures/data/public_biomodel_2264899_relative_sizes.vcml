<BioModel Name="PingPong2">
   <Model Name="PingPong2">
      <Compound Name="Ca">
         <Annotation>Calcium</Annotation>
      </Compound>
      <Feature Name="ER" KeyValue="14703" />
      <Feature Name="cyto" KeyValue="14701" />
      <Membrane InsideFeature="ER" OutsideFeature="cyto" MembraneVoltage="Voltage_ERMem" Name="ERMem" KeyValue="14702" />
      <LocalizedCompound Name="Ca_cyto" CompoundRef="Ca" Structure="cyto" OverrideName="false" KeyValue="14707" />
      <LocalizedCompound Name="Ca_ERMem" CompoundRef="Ca" Structure="ERMem" OverrideName="false" KeyValue="14708" />
      <SimpleReaction Structure="ERMem" Name="reaction0" FluxCarrierValence="0" FluxOption="MolecularOnly" KeyValue="14709">
         <Reactant LocalizedCompoundRef="Ca_cyto" Stoichiometry="1" KeyValue="14711" />
         <Product LocalizedCompoundRef="Ca_ERMem" Stoichiometry="1" KeyValue="14710" />
         <Kinetics KineticsType="MassAction">
            <Parameter Name="J" Role="reaction rate" Unit="molecules.um-2.s-1">((Kf * Ca_cyto) - (Kr * Ca_ERMem))</Parameter>
            <Parameter Name="I" Role="inward current density" Unit="pA.um-2">0.0</Parameter>
            <Parameter Name="Kf" Role="forward rate constant" Unit="molecules.um-2.uM-1.s-1">(Kon * (t &lt; 8.0))</Parameter>
            <Parameter Name="Kr" Role="reverse rate constant" Unit="s-1">(Koff * (t &gt; 8.0))</Parameter>
            <Parameter Name="Kon" Role="user defined" Unit="molecules.um-2.s-1">20.0</Parameter>
            <Parameter Name="Koff" Role="user defined" Unit="molecules.um-2.s-1">0.0050</Parameter>
         </Kinetics>
      </SimpleReaction>
      <Diagram Name="Feature0_diagram" Structure="cyto" />
      <Diagram Name="Feature1_diagram" Structure="ER" />
      <Diagram Name="Membrane0_diagram" Structure="ERMem">
         <LocalizedCompoundShape LocalizedCompoundRef="Ca_ERMem" LocationX="225" LocationY="79" />
         <LocalizedCompoundShape LocalizedCompoundRef="Ca_cyto" LocationX="60" LocationY="44" />
         <SimpleReactionShape SimpleReactionRef="reaction0" LocationX="99" LocationY="108" />
      </Diagram>
      <Version Name="PingPong2" KeyValue="14700" BranchId="14598" Archived="0" Date="11-Jun-2000 09:28:30" FromVersionable="false">
