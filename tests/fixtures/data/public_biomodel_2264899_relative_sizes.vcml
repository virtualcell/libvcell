            <Owner Name="schaff" Identifier="17" />
            <GroupAccess Type="1" />
         </Version>
      </Geometry>
      <GeometryContext>
         <FeatureMapping Feature="ER" SubVolume="Compartment" Resolved="false">
            <BoundariesTypes Xm="Value" Xp="Value" Ym="Value" Yp="Value" Zm="Value" Zp="Value" />
         </FeatureMapping>
         <FeatureMapping Feature="cyto" SubVolume="Compartment" Resolved="false">
            <BoundariesTypes Xm="Value" Xp="Value" Ym="Value" Yp="Value" Zm="Value" Zp="Value" />
         </FeatureMapping>
         <MembraneMapping Membrane="ERMem" SurfaceToVolumeRatio="1.0" VolumeFraction="0.2" CalculateVoltage="false" SpecificCapacitance="1.0" InitialVoltage="0.0" />
      </GeometryContext>
      <ReactionContext>
         <LocalizedCompoundSpec LocalizedCompoundRef="Ca_ERMem" ForceConstant="false" EnableDiffusion="false">
            <Initial>0.0</Initial>
            <Diffusion>0.0</Diffusion>
         </LocalizedCompoundSpec>
         <LocalizedCompoundSpec LocalizedCompoundRef="Ca_cyto" ForceConstant="false" EnableDiffusion="true">
            <Initial>1.0</Initial>
            <Diffusion>0.0</Diffusion>
         </LocalizedCompoundSpec>
         <ReactionSpec ReactionStepRef="reaction0" ReactionMapping="included" />
      </ReactionContext>
      <MathDescription Name="PingPong2_compartmental_14699">
         <Constant Name="Koff">0.0050</Constant>
         <Constant Name="_T_">300.0</Constant>
         <Constant Name="K_milliVolts_per_Volt">1000.0</Constant>
         <Constant Name="Ca_cyto_init">1.0</Constant>
         <Constant Name="_F_">96480.0</Constant>
         <Constant Name="_R_">8314.0</Constant>
         <Constant Name="VolFract_ER">0.2</Constant>
         <Constant Name="Ca_ERMem_init">0.0</Constant>
         <Constant Name="KMOLE">0.0016611295681063123</Constant>
         <Constant Name="Kon">20.0</Constant>
         <Constant Name="SurfToVol_ERMem">1.0</Constant>
         <VolumeVariable Name="Ca_cyto" />
         <Function Name="Voltage_ERMem">0.0</Function>
         <Function Name="Kflux_ERMem_cyto">(SurfToVol_ERMem * VolFract_ER / (1.0 - VolFract_ER))</Function>
         <Function Name="Kf_reaction0">(Kon * (t &lt; 8.0))</Function>
         <Function Name="Kr_reaction0">(Koff * (t &gt; 8.0))</Function>
         <Function Name="K_Ca_ERMem_total">((Ca_ERMem_init * SurfToVol_ERMem * VolFract_ER * KMOLE) + ((1.0 - VolFract_ER) * Ca_cyto_init))</Function>
         <Function Name="Ca_ERMem">((K_Ca_ERMem_total - ((1.0 - VolFract_ER) * Ca_cyto)) / (SurfToVol_ERMem * VolFract_ER * KMOLE))</Function>
         <Function Name="J_reaction0">((Kf_reaction0 * Ca_cyto) - (Kr_reaction0 * Ca_ERMem))</Function>
         <Function Name="Kflux_ERMem_ER">SurfToVol_ERMem</Function>
         <CompartmentSubDomain Name="Compartment">
            <BoundaryType Boundary="Xm" Type="Value" />
            <BoundaryType Boundary="Xp" Type="Value" />
            <BoundaryType Boundary="Ym" Type="Value" />
            <BoundaryType Boundary="Yp" Type="Value" />
            <BoundaryType Boundary="Zm" Type="Value" />
            <BoundaryType Boundary="Zp" Type="Value" />
            <OdeEquation Name="Ca_cyto" SolutionType="Unknown">
               <Rate> - (Kflux_ERMem_cyto * KMOLE * J_reaction0)</Rate>
               <Initial>Ca_cyto_init</Initial>
            </OdeEquation>
         </CompartmentSubDomain>
         <Version Name="PingPong2_compartmental_14699" KeyValue="2209399" BranchId="2003265" Archived="0" Date="25-Oct-2001 14:26:07" FromVersionable="false">
